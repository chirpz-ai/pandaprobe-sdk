  "schemas": {
    "CreateBatchEvalRunRequest": {
      "description": "Create an eval run for an explicit list of trace IDs.\n\nUse this when the user has manually selected specific traces in the\ndashboard rather than using filter-based selection.",
      "properties": {
        "metrics": {
          "description": "List of metric names to run on each trace. Example: ['task_completion', 'step_efficiency'].",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "LLM model string override for the judge. Null uses the system default.",
          "title": "Model"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional human-readable label for this run.",
          "title": "Name"
        },
        "trace_ids": {
          "description": "List of trace UUIDs to evaluate. Duplicates are removed automatically.",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Trace Ids",
          "type": "array"
        }
      },
      "required": [
        "trace_ids",
        "metrics"
      ],
      "title": "CreateBatchEvalRunRequest",
      "type": "object"
    },
